
# Local development settings only.
# Never commit or share your actual .env file.

HEALTHOPS_ENV=development
HEALTHOPS_HOST=127.0.0.1
HEALTHOPS_PORT=8765
HEALTHOPS_MAX_UPLOAD_MB=100
HEALTHOPS_LOG_LEVEL=INFO
HEALTHOPS_DATA_DIR=instance

# Gemini is used for schema-aware query planning only.
# Patient-level records are processed locally.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
HEALTHOPS_LLM_ENABLED=true
HEALTHOPS_LLM_TIMEOUT_SECONDS=30
